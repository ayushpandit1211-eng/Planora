# ---------------------------------------------------------------------------
# Planora environment configuration. Copy to .env and edit.
# Never commit a real .env file.
# ---------------------------------------------------------------------------

# --- PostgreSQL superuser (used ONLY by the db container and seed script) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=querysentinel
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Restricted application role (least privilege, created by init_db.sql) ---
# This role can SELECT business tables, run EXPLAIN, use HypoPG and write only
# to the optimizer_meta schema. It has NO write privilege on business tables.
QS_APP_USER=qs_app
QS_APP_PASSWORD=change-me-app

# --- Privacy ---
# HMAC key for deterministic structural pseudonyms (tbl_xxxxxx / col_xxxxxx).
# If empty, a random per-process key is generated (pseudonyms then change on restart).
PRIVACY_HMAC_KEY=
# Request-scoped in-memory vault lifetime.
VAULT_TTL_SECONDS=1800

# --- Security gateway ---
MAX_QUERY_LENGTH=20000
STATEMENT_TIMEOUT_MS=15000
# Optional API key for the FastAPI backend (empty = no auth, local prototype only)
QS_API_KEY=

# --- LLM provider (optional). none | gemini | openai | mock ---
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
# For OpenAI-compatible endpoints (OpenAI, Azure-compatible gateways, local vLLM/Ollama)
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# --- Models ---
GNN_CHECKPOINT_PATH=models/gnn_bottleneck.pt
RL_POLICY_PATH=models/rl_policy.json

# --- Benchmark (actual execution timing). Keep false unless DB is disposable ---
BENCHMARK_ENABLED=false
BENCHMARK_REPETITIONS=3
# DSN of a DISPOSABLE database copy with DDL rights. Indexes are built inside a transaction
# that is always rolled back; never point this at production.
BENCHMARK_ADMIN_DSN=

# --- Optimization budget (Addendum R9) ---
BUDGET_MAX_INDEX_CANDIDATES=8
BUDGET_MAX_HYPOPG_EXPERIMENTS=10
BUDGET_MAX_AGENT_STEPS=20
BUDGET_MAX_LLM_RETRIES=2
BUDGET_MAX_WORKLOAD_QUERIES=50

# --- Workload drift (Addendum R8) ---
DRIFT_JS_THRESHOLD=0.2

# --- Seed data (lightweight defaults; full mode = 100 / 1000000 / 3000000) ---
SEED_TENANTS=100
SEED_ORDERS=100000
SEED_ORDER_ITEMS=300000
SEED_RANDOM_SEED=42
SEED_ON_START=true

# --- Service URLs ---
BACKEND_URL=http://backend:8000
LOG_LEVEL=INFO

# ===========================================================================
# Final Upgrade (see .build_state/UPGRADE_PLAN.md). All optional with defaults.
# ===========================================================================
# --- Feature flags (additive routes on; behaviour-changing features off until enabled) ---
QS_FEATURE_INGESTION=true
QS_FEATURE_NLQ=true
QS_FEATURE_GATV2=false
QS_FEATURE_RL_UPGRADES=false
QS_FEATURE_DP=false
QS_FEATURE_INDEX_PORTFOLIO=false
QS_METADATA_SCHEMA=qs_meta
# single_user (docker default: every dashboard tab sees all datasets) | per_session (ownership per browser session)
QS_SESSION_MODE=single_user
QS_RUN_META_MIGRATION=true

# --- Dynamic dataset ingestion (CSV / JSON -> schema qs_dynamic in the main DB) ---
INGEST_TARGET_SCHEMA=qs_dynamic
INGEST_MAX_UPLOAD_MB=100
INGEST_SAMPLE_ROWS=10000
INGEST_MAX_REJECT_RATIO=0.01
INGEST_ALLOW_WIDENING=false
INGEST_NULL_TOKENS=,NULL,null,NA,N/A,n/a,None,none,-,nan,NaN

# --- Natural-language-to-SQL ---
NLQ_MAX_RETRIES=2
NLQ_MAX_ROWS=1000
NLQ_STATEMENT_TIMEOUT_MS=10000
NLQ_MAX_PLAN_COST=50000000
NLQ_ALLOWED_FUNCTIONS=
NLQ_SCHEMA_CONTEXT_MAX_TABLES=15
NLQ_SAMPLE_VALUES=true

# --- Differential privacy for AI-facing aggregates ---
DP_EPSILON_PER_RELEASE=0.5
DP_EPSILON_BUDGET_TOTAL=5.0
DP_BUDGET_SCOPE=session

# --- Search budget aliases (the BUDGET_MAX_* names above also work) ---
# MAX_INDEX_CANDIDATES / MAX_HYPOPG_EXPERIMENTS / MAX_AGENT_STEPS / MAX_LLM_RETRIES / MAX_HISTORICAL_QUERIES
BUDGET_MAX_SANDBOX_BENCHMARKS=3
