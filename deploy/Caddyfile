{
    email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
    basic_auth {
        {$DEMO_USER} {$DEMO_PASSWORD_HASH}
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    request_body {
        max_size 105MB
    }
    reverse_proxy {$DASHBOARD_UPSTREAM:dashboard:8501}
}
